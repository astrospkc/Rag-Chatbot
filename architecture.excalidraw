      "boundElements": [],
      "updated": 1789117133354,
      "link": null,
      "locked": false,
      "text": "ARCHITECTURE AND DATA FLOW IN \nMICROSERVICES - MONOREPO",
      "fontSize": 28,
      "fontFamily": 7,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ARCHITECTURE AND DATA FLOW IN \nMICROSERVICES - MONOREPO",
      "autoResize": true,
      "lineHeight": 1.15
    },
    {
      "id": "CUpQ0qg59C9evBD7FkQ0F",
      "type": "text",
      "x": 1267.1127545961804,
      "y": 3324.5489838949006,
      "width": 562.3262939453125,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0H",
      "roundness": null,
      "seed": 10278777,
      "version": 176,
      "versionNonce": 171393335,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789117127356,
      "link": null,
      "locked": false,
      "text": "The frontend establishes a persistent\nWebSocket connection to the Go service.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The frontend establishes a persistent WebSocket connection to the Go service.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "4UgymKz3qC2umPyhaa5BJ",
      "type": "text",
      "x": 1256.5657864359569,
      "y": 3436.154948666629,
      "width": 593.7423095703125,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0I",
      "roundness": null,
      "seed": 98121879,
      "version": 177,
      "versionNonce": 1651667767,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789117128628,
      "link": null,
      "locked": false,
      "text": "The user types a question: Frontend sends\nJSON over the WebSocket to Go.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The user types a question: Frontend sends JSON over the WebSocket to Go.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "pWMjNMXQbnw2ganDW-Wa7",
      "type": "text",
      "x": 1260.0731653412224,
      "y": 3542.2774044210455,
      "width": 623.2265625,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0J",
      "roundness": null,
      "seed": 1239777369,
      "version": 189,
      "versionNonce": 912387415,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789117130213,
      "link": null,
      "locked": false,
      "text": "Go forwards the query to Python's streaming\nendpoint (POST\nhttp://localhost:8000/query/stream).",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Go forwards the query to Python's streaming endpoint (POST http://localhost:8000/query/stream).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ivf1feomeD24KS9_wwr4n",
      "type": "text",
      "x": 1258.2642370410235,
      "y": 3680.284242374981,
      "width": 650.3587036132812,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0K",
      "roundness": null,
      "seed": 1366560183,
      "version": 118,
      "versionNonce": 1218764407,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789117113393,
      "link": null,
      "locked": false,
      "text": "Python generates the answer with the LLM and\nstreams tokens back to Go.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Python generates the answer with the LLM and streams tokens back to Go.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "JktzQfvIuzLOk0247sV8F",
      "type": "text",
      "x": 1246.565328685252,
      "y": 3793.27340035335,
      "width": 638.9346313476562,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0L",
      "roundness": null,
      "seed": 971377977,
      "version": 126,
      "versionNonce": 537259735,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789117111280,
      "link": null,
      "locked": false,
      "text": "Go pushes each token down the WebSocket to\nthe browser in real time.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Go pushes each token down the WebSocket to the browser in real time.",
      "autoResize": false,
      "lineHeight": 1.25
    },
