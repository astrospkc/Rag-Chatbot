      "link": null,
      "locked": false,
      "text": "project-structure:\n├── rag/\n│   │   │   │\n│   │   │   ├── loaders/\n│   │   │   │   ├── pdf.py\n│   │   │   │   ├── docx.py\n│   │   │   │   └── web.py\n│   │   │   │\n│   │   │   ├── chunking/\n│   │   │   │   └── chunker.py\n│   │   │   │\n│   │   │   ├── embeddings/\n│   │   │   │   └── embedding_service.py\n│   │   │   │\n│   │   │   ├── retrieval/\n│   │   │   │   ├── vector_retriever.py\n│   │   │   │   ├── keyword_retriever.py\n│   │   │   │   ├── hybrid_retriever.py\n│   │   │   │   └── reranker.py\n│   │   │   │\n│   │   │   ├── generation/\n│   │   │   │   ├── prompt.py\n│   │   │   │   └── generator.py\n│   │   │   │\n│   │   │   ├── pipeline.py\n│   │   │   └── router.py",
