# ==========================================
# Database (PostgreSQL with pgvector extension)
# ==========================================
DB_URL=postgresql://postgres:your_password@your_host:5432/postgres

# ==========================================
# Celery Message Broker (RabbitMQ)
# ==========================================
# Local Docker RabbitMQ (default when running docker compose up -d):
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# Or CloudAMQP (if using cloud broker):
# CLOUDAMQP_URL=amqps://user:pass@host/vhost

# ==========================================
# LLM & Embedding API Keys
# ==========================================
OPENROUTER_ADMIN_KEY=your_openrouter_key
GEMINI_API_KEY=your_gemini_key

# ==========================================
# File Storage (AWS S3)
# ==========================================
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
AWS_BUCKET=your_bucket_name
AWS_REGION=us-east-1

